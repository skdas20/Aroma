# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amara?schema=public
# Example: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend URL (for CORS)
FRONTEND_URL=https://aroma-blush.vercel.app
# For development: FRONTEND_URL=http://localhost:3000

# Session Secret
SESSION_SECRET=your-session-secret-here

# SMTP Email (required for order confirmation)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Mail identity
MAIL_FROM_NAME=AMARAA LUXURY
MAIL_FROM_EMAIL=orders@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
