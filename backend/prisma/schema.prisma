// Prisma schema for Amara Aroma backend using PostgreSQL
// Normalized schema following the database design plan

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Customer Table - Store customer personal details and total spending
model Customer {
    cid              String   @id @default(uuid()) // Customer ID (Primary Key)
  name             String?  // Full name of the customer
  phoneNo          String?  // Contact number
  address          String?  // Residential or business address
  email            String   @unique // Customer email address
  createdAt        DateTime @default(now()) // Timestamp of record creation
  totalExpenditure Decimal  @db.Decimal(12, 2) @default(0) // Total amount spent

  orders Order[]
  cart   Cart?
}

// Products Table - Maintain information about products available for sale
model Product {
  pid           String    @id @default(uuid()) // Product ID (Primary Key)
  numericId     Int       @unique // Corresponds to the ID in perfumes.js
  name          String
  brand         String
  category      String
  sex           String    @default("Unisex") // Men, Women, or Unisex
  description   String
  price         Decimal   @db.Decimal(12, 2)
  originalPrice Decimal   @db.Decimal(12, 2)
  image         String
  images        String[]
  notes         Json      // Storing as JSONB in PostgreSQL
  size          String
  stock         Int       @default(0)
  rating        Float
  reviews       Int

  orderProducts OrderProduct[]
  cartItems     CartItem[]
}

// Orders Table - Store transaction details of purchases made by customers
model Order {
  orderId    String   @id @default(uuid()) // Order ID (Primary Key)
  customerId String   // Foreign Key linking to Customer.cid
  date       DateTime @default(now()) // Order date
  total      Decimal  @db.Decimal(12, 2) // Total price of the order

  customer      Customer       @relation(fields: [customerId], references: [cid])
  orderProducts OrderProduct[]

  @@index([customerId])
}

// Order_Products Table - Junction table for many-to-many relationship between Orders and Products
model OrderProduct {
  orderId         String  // Foreign Key to Orders.orderId
  productId       String  // Foreign Key to Products.pid
  quantity        Int     // Units purchased of that product
  priceAtPurchase Decimal @db.Decimal(12, 2) // Price per unit at the time of purchase

  order   Order   @relation(fields: [orderId], references: [orderId])
  product Product @relation(fields: [productId], references: [pid])

  @@id([orderId, productId]) // Composite primary key
  @@index([orderId])
  @@index([productId])
}

// Cart Table - Stores items a customer intends to purchase
model Cart {
  id        String   @id @default(uuid())
  customerId String   @unique // Each customer has one cart
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [cid], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
}

// CartItem Table - Junction table for Carts and Products
model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [pid], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}
